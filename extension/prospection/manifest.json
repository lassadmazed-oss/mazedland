{
  "manifest_version": 3,
  "name": "Mazed Immo — Prospection",
  "short_name": "Mazed Prospection",
  "version": "1.0.0",
  "description": "Envoie le post Facebook affiché vers la fiche « Nouvelle annonce trouvée » de Mazed Immo, le texte déjà rempli. Ne lit la page que lorsque vous cliquez.",
  "minimum_chrome_version": "100",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Envoyer ce post à Mazed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
